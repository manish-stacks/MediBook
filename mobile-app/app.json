{
  "expo": {
    "name": "MediBook",
    "slug": "medibook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/splash.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.medibook.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.medibook.app"
    },
    "web": {
      "favicon": "./assets/splash.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "medibook",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b4361921-2c81-4d30-a006-b1e48a063d45"
      }
    }
  }
}
