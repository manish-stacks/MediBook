// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  SUPER_ADMIN
  CLINIC_ADMIN
  DOCTOR
  PATIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  RESCHEDULED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMode {
  ONLINE
  PAY_AT_CLINIC
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum RelationType {
  SELF
  SPOUSE
  CHILD
  PARENT
  SIBLING
  OTHER
}

// ==================== CORE MODELS ====================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?   @unique
  password      String
  firstName     String
  lastName      String
  avatar        String?
  dateOfBirth   DateTime?
  gender        Gender?
  role          Role      @default(PATIENT)
  isActive      Boolean   @default(true)
  isVerified    Boolean   @default(false)
  refreshToken  String?   @db.Text
  otp           String?
  otpExpiry     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  doctor        Doctor?
  clinicAdmin   ClinicAdmin?
  patients      Patient[]
  appointments  Appointment[]
  reviews       Review[]
  notifications Notification[]
  blogPosts     BlogPost[]
  contactForms  ContactForm[]
  favoriteDoctors FavoriteDoctor[]

  @@map("users")
}

model Speciality {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  icon        String?
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors Doctor[]

  @@map("specialities")
}

model Clinic {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  address     String
  city        String
  state       String
  pincode     String
  phone       String?
  email       String?
  website     String?
  logo        String?
  images      Json?    // Array of image URLs
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  clinicAdmins  ClinicAdmin[]
  doctors       DoctorClinic[]
  appointments  Appointment[]

  @@map("clinics")
}

model ClinicAdmin {
  id        String   @id @default(uuid())
  userId    String   @unique
  clinicId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("clinic_admins")
}

model Doctor {
  id                String   @id @default(uuid())
  userId            String   @unique
  specialityId      String
  registrationNo    String?
  experience        Int      @default(0) // years
  about             String?  @db.Text
  education         Json?    // Array of {degree, institution, year}
  languages         Json?    // Array of strings
  consultationFee   Decimal  @default(0) @db.Decimal(10, 2)
  followUpFee       Decimal  @default(0) @db.Decimal(10, 2)
  rating            Decimal  @default(0) @db.Decimal(3, 2)
  totalReviews      Int      @default(0)
  bookingUrl        String?  @unique
  isAvailable       Boolean  @default(true)
  isVerified        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  speciality    Speciality    @relation(fields: [specialityId], references: [id])
  clinics       DoctorClinic[]
  slots         DoctorSlot[]
  appointments  Appointment[]
  reviews       Review[]
  prescriptions Prescription[]
  earnings      DoctorEarning[]
  favoritedBy   FavoriteDoctor[]

  @@map("doctors")
}

model DoctorClinic {
  id        String   @id @default(uuid())
  doctorId  String
  clinicId  String
  createdAt DateTime @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([doctorId, clinicId])
  @@map("doctor_clinics")
}

// ==================== SLOTS ====================

model DoctorSlot {
  id          String    @id @default(uuid())
  doctorId    String
  day         DayOfWeek
  startTime   String    // "HH:MM" format
  endTime     String    // "HH:MM" format
  duration    Int       @default(30) // minutes per slot
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  doctor      Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  timeSlots   TimeSlot[]

  @@map("doctor_slots")
}

model TimeSlot {
  id           String     @id @default(uuid())
  doctorSlotId String
  date         DateTime
  startTime    String
  endTime      String
  status       SlotStatus @default(AVAILABLE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  doctorSlot   DoctorSlot   @relation(fields: [doctorSlotId], references: [id], onDelete: Cascade)
  appointment  Appointment?

  @@unique([doctorSlotId, date, startTime])
  @@map("time_slots")
}

// ==================== PATIENTS ====================

model Patient {
  id           String      @id @default(uuid())
  userId       String
  firstName    String
  lastName     String
  dateOfBirth  DateTime
  gender       Gender
  bloodGroup   String?
  relation     RelationType @default(SELF)
  phone        String?
  email        String?
  address      String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  vitals        PatientVital[]
  prescriptions Prescription[]
  medicalNotes  MedicalNote[]

  @@map("patients")
}

model PatientVital {
  id               String   @id @default(uuid())
  patientId        String
  bloodPressure    String?
  height           Decimal? @db.Decimal(5, 2)
  weight           Decimal? @db.Decimal(5, 2)
  temperature      Decimal? @db.Decimal(4, 1)
  heartRate        Int?
  oxygenSaturation Decimal? @db.Decimal(4, 1)
  pulse            Int?
  notes            String?  @db.Text
  recordedAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_vitals")
}

// ==================== APPOINTMENTS ====================

model Appointment {
  id             String            @id @default(uuid())
  appointmentNo  String            @unique
  userId         String
  patientId      String
  doctorId       String
  clinicId       String
  timeSlotId     String?           @unique
  scheduledDate  DateTime
  scheduledTime  String
  status         AppointmentStatus @default(PENDING)
  paymentMode    PaymentMode       @default(PAY_AT_CLINIC)
  notes          String?           @db.Text
  cancelReason   String?
  isRescheduled  Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user        User          @relation(fields: [userId], references: [id])
  patient     Patient       @relation(fields: [patientId], references: [id])
  doctor      Doctor        @relation(fields: [doctorId], references: [id])
  clinic      Clinic        @relation(fields: [clinicId], references: [id])
  timeSlot    TimeSlot?     @relation(fields: [timeSlotId], references: [id])
  payment     Payment?
  prescription Prescription?
  review      Review?

  @@map("appointments")
}

// ==================== PAYMENTS ====================

model Payment {
  id              String        @id @default(uuid())
  appointmentId   String        @unique
  userId          String
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  paymentMode     PaymentMode
  razorpayOrderId String?
  razorpayPaymentId String?
  razorpaySignature String?
  stripePaymentId String?
  receiptUrl      String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@map("payments")
}

model DoctorEarning {
  id            String   @id @default(uuid())
  doctorId      String
  appointmentId String
  amount        Decimal  @db.Decimal(10, 2)
  platformFee   Decimal  @db.Decimal(10, 2) @default(0)
  netAmount     Decimal  @db.Decimal(10, 2)
  status        String   @default("pending") // pending, settled
  settledAt     DateTime?
  createdAt     DateTime @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@map("doctor_earnings")
}

// ==================== PRESCRIPTIONS ====================

model Prescription {
  id            String   @id @default(uuid())
  appointmentId String   @unique
  doctorId      String
  patientId     String
  diagnosis     String?  @db.Text
  notes         String?  @db.Text
  followUpDate  DateTime?
  pdfUrl        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment Appointment  @relation(fields: [appointmentId], references: [id])
  doctor      Doctor       @relation(fields: [doctorId], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id])
  medicines   Medicine[]

  @@map("prescriptions")
}

model Medicine {
  id             String   @id @default(uuid())
  prescriptionId String
  name           String
  dosage         String?  // e.g., "500mg"
  morning        Boolean  @default(false)
  afternoon      Boolean  @default(false)
  evening        Boolean  @default(false)
  duration       Int?     // days
  instructions   String?
  createdAt      DateTime @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("medicines")
}

model MedicalNote {
  id        String   @id @default(uuid())
  patientId String
  doctorId  String
  note      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("medical_notes")
}

// ==================== REVIEWS ====================

model Review {
  id            String   @id @default(uuid())
  userId        String
  doctorId      String
  appointmentId String   @unique
  rating        Int
  comment       String?  @db.Text
  isApproved    Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  doctor      Doctor      @relation(fields: [doctorId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@map("reviews")
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   // appointment, payment, system
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ==================== BLOG ====================

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  excerpt     String?  @db.Text
  content     String   @db.LongText
  coverImage  String?
  tags        Json?
  authorId    String
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User     @relation(fields: [authorId], references: [id])

  @@map("blog_posts")
}

model ContactForm {
  id        String   @id @default(uuid())
  userId    String?
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@map("contact_forms")
}

// ==================== FAVORITES ====================

model FavoriteDoctor {
  id        String   @id @default(uuid())
  userId    String
  doctorId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([userId, doctorId])
  @@map("favorite_doctors")
}

// ==================== TESTIMONIALS ====================

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  location  String?
  avatar    String?
  rating    Int      @default(5)
  text      String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

// ==================== SETTINGS ====================

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  group     String   @default("general") // general, payment, seo, social
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ==================== STATIC PAGES ====================

model StaticPage {
  id        String   @id @default(uuid())
  slug      String   @unique // terms, privacy, refund, about
  title     String
  content   String   @db.LongText
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("static_pages")
}
